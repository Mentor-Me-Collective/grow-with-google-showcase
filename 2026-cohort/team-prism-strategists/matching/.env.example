# =====================================================================
# Mentor Me - Environment Configuration
# =====================================================================

# 1. AI Career Advisor (Choose Google Gemini or OpenAI)
# Get a free Google Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternatively, use OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here

# 2. Application Secret Key for JWT Authentication
SECRET_KEY=mentor_me_secure_jwt_secret_key_change_in_production

# 3. Single Sign-On (SSO) OAuth Credentials (Optional)
# Google OAuth 2.0 Credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Facebook Login Credentials: https://developers.facebook.com/apps
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# 4. Email Dispatcher for Double Authentication (SMTP) & Password Reset (Optional)
# To send real 2FA / reset emails via Gmail, create an App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# 5. External Directory API Keys (Optional)
# GitHub Personal Access Token (for unrestricted developer search): https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# ORCID Public API (for academic researcher search): https://orcid.org/developer-tools
ORCID_CLIENT_ID=your_orcid_client_id_here
ORCID_CLIENT_SECRET=your_orcid_client_secret_here

# 6. Production URLs (Required for Cloud Deployment: Render, Railway, Streamlit Cloud)
# Set your public web app URL so invite codes, email links, and OAuth redirects use your live domain
APP_BASE_URL=http://localhost:8501
# In production, set APP_BASE_URL to your public domain (e.g., https://mentor-me-frontend.onrender.com)
API_URL=http://127.0.0.1:8000/api/v1
# In production, set API_URL to your public backend URL (e.g., https://mentor-me-backend.onrender.com/api/v1)

# 7. Production Database Connection (Defaults to SQLite if not provided)
# DATABASE_URL=postgresql://user:password@hostname:5432/mentorme_db


