# Where the *browser* reaches the API. Locally this is the FastAPI service; on
# Railway or Render it is the api service's public URL. Inlined into the client
# bundle at build time, so on a platform that builds your image it must be set
# as a build variable — passing it only at runtime produces an app that starts
# cleanly and then sends every request to the visitor's own machine.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Where *this Next.js process* reaches the API, when that differs. Under Docker
# Compose the browser uses the published port above while the server container
# must use the service name, and one value cannot be both. Leave it unset
# anywhere the two addresses are the same, which is most places.
# API_URL_INTERNAL=http://api:8000/v1

# "enabled" runs the MSW mock backend, so the frontend works with no API at all.
# Set to "disabled" once the real api is up. Mocking is off in production builds
# regardless, so a deployed app always talks to the real thing.
NEXT_PUBLIC_API_MOCKING=enabled

# Shows the "Just looking?" entry on the sign-in screen. Only useful when the
# API is also running with DEMO_MODE=true — the endpoint behind it 404s
# otherwise, so this is an affordance rather than the control.
NEXT_PUBLIC_DEMO_MODE=false
