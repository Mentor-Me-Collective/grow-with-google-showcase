# Where the browser and the server should reach the API.
# Locally this is the FastAPI service; on Railway or Render it is the api
# service's public URL. This is the only value that changes between them.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# "enabled" runs the MSW mock backend, so the frontend works with no API at all.
# Set to "disabled" once the real api is up. Mocking is off in production builds
# regardless, so a deployed app always talks to the real thing.
NEXT_PUBLIC_API_MOCKING=enabled

# Shows the "Just looking?" entry on the sign-in screen. Only useful when the
# API is also running with DEMO_MODE=true — the endpoint behind it 404s
# otherwise, so this is an affordance rather than the control.
NEXT_PUBLIC_DEMO_MODE=false
