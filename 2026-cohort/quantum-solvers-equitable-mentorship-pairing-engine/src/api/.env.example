# Required. No default: a service that silently falls back to a local database
# looks healthy in production while writing nowhere useful.
DATABASE_URL=postgresql+psycopg://braid:braid@localhost:5433/braid

# Must name the frontend's origin exactly. The frontend sends credentials, and
# browsers reject a wildcard origin on credentialed requests.
WEB_ORIGIN=http://localhost:3000

# "production" makes the session cookie Secure, which localhost cannot use.
ENVIRONMENT=development

# Locally the frontend and API differ only by port, which is the same site, so
# Lax works. Deployed to separate hosts they are cross-site and a Lax cookie is
# dropped on every API call — an auth failure that appears only in production.
# Set this to "none" there; Secure is then forced on automatically.
SESSION_COOKIE_SAMESITE=lax

# Opens POST /auth/demo, which signs in as a seeded account so a reviewer can
# get inside a deployed copy. The endpoint 404s unless this is true. Never
# enable it on a deployment holding a real cohort's data.
DEMO_MODE=false

# Leave unset and nothing is delivered: app.mail logs the message instead, and
# the sign-in link appears in the server output ready to paste into the browser.
# That is how a local run needs no provider account.
RESEND_API_KEY=

# Only meaningful with a key set, and the line most likely to waste an hour.
# Resend's shared sender — onboarding@resend.dev — delivers only to the address
# that owns the Resend account. It looks like working email until the first
# other person tries to sign in and never hears back. To let anybody else in,
# verify a domain with the provider and put an address at it here.
MAIL_FROM=Braid <onboarding@resend.dev>
